# Copy to .env, or run `python scripts/setup_wallets.py` (it creates .env and fills in the wallets).
# NEVER commit .env. NEVER paste these keys into chat. Testnet wallets only.

# ---- Chain: Base Sepolia testnet (Person 1) ----
RPC_URL=https://sepolia.base.org
# Circle's test USDC on Base Sepolia. Leave as is.
USDC_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e
# 1 = sign nothing and touch no network (safe for demos and tests)
DRY_RUN=0

# ---- 3 test wallets (setup_wallets.py fills these in) ----
OWNER_PRIVATE_KEY=
OWNER_ADDRESS=
VENDOR_PRIVATE_KEY=
VENDOR_ADDRESS=
ATTACKER_PRIVATE_KEY=
ATTACKER_ADDRESS=

# ---- LLM keys: agent (Person 1) and the firewall's intent judge (Person 2). One is enough. ----
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Firewall intent check: leave empty (auto), or set offline / online
INTENT_MODE=

# ---- Telegram bot (Person 1) ----
OWNER_TELEGRAM_ID=
TELEGRAM_BOT_TOKEN=
# llm | naive. Empty = llm if an API key is set above, otherwise naive.
BOT_AGENT=
# Strangers: max requests per window (seconds). The owner has a higher fixed limit.
BOT_RATE_LIMIT_MAX=5
BOT_RATE_LIMIT_WINDOW=60

# ---- TigerGraph (Person 3). Leave TG_HOST empty to use the local NetworkX fallback. ----
TG_HOST=
TG_GRAPH=provenant
TG_SECRET=
# Attack-pattern embeddings: hash (offline, what TigerGraph is loaded with) or openai (needs OPENAI_API_KEY + reload)
EMBEDDER=hash
